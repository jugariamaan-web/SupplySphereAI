# Used by docker-compose.yml only (variable substitution).
# Copy to ".env" in the project root before running `docker compose up`.
# For LOCAL (non-Docker) runs, use backend/.env instead.

DB_PASSWORD=supplysphere_root
DB_NAME=supplysphere
GROQ_API_KEY=your_api_key_here
# llama-3.3-70b-versatile was deprecated by Groq on 2026-06-17 and shuts down
# 2026-08-16 (https://console.groq.com/docs/deprecations) - use their
# recommended replacement instead (kept in sync with backend/.env.example
# and backend/copilot.py's DEFAULT_MODEL):
GROQ_MODEL=openai/gpt-oss-120b
# Comma-separated origins allowed to call the API from a browser. Only
# needed if you're exposing this somewhere other than localhost:8000.
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
