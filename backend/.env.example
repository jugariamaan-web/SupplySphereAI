# Copy this file to ".env" and fill in your real values.
# .env should NEVER be committed to GitHub.

# --- MySQL Database ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=supplysphere

# --- Groq (AI Copilot & AI Reports) ---
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_api_key_here
# llama-3.3-70b-versatile was deprecated by Groq on 2026-06-17 and shuts
# down 2026-08-16 (https://console.groq.com/docs/deprecations) - use their
# recommended replacement instead:
GROQ_MODEL=openai/gpt-oss-120b

# --- CORS ---
# Comma-separated list of origins allowed to call this API from a browser.
# Defaults to localhost if unset - safe for local dev, but set this to your
# actual frontend URL(s) before deploying anywhere reachable off localhost.
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
